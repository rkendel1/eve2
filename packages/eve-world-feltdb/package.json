{
  "name": "@eve/world-feltdb",
  "version": "0.0.0",
  "description": "FeltDB storage for eve's Workflow World: durable payload storage with verified references (the World itself is not implemented yet)",
  "keywords": [
    "eve",
    "feltdb",
    "workflow-world"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/rkendel1/eve2.git",
    "directory": "packages/eve-world-feltdb"
  },
  "files": [
    "dist",
    "README.md",
    "NOTICE"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node ../../scripts/copy-package-license.mjs .",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:scenario": "vitest run --config vitest.scenario.config.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@feltdb/core": "0.23.0",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@feltdb/core": ">=0.23.0 <0.25.0"
  },
  "engines": {
    "node": ">=26"
  }
}
